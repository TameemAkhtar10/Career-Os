# ==============================================================================
# Career OS Backend Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Server & Environment
PORT=5000
NODE_ENV=development

# Database (MongoDB connection string)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/careeros?retryWrites=true&w=majority

# Web Client URL (used for CORS and auth cookie credentials)
CLIENT_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# JWT Secrets (Generate secure random 32+ character strings)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EMAIL_SECRET=your_jwt_email_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Brevo Transactional Email (REST API)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=no-reply@yourdomain.com

# Scheduled Emails (Cron) Configuration
CRON_SECRET=your_cron_secret_key_here
ENABLE_INTERNAL_CRON=false
CRON_TIMEZONE=Asia/Kolkata
JOB_DIGEST_CRON=0 9 * * *
RECRUITER_DIGEST_CRON=0 18 * * *
JOB_CLOSE_CRON=30 0 * * *
PROFILE_NUDGE_CRON=0 11 * * 1
EMAIL_DAILY_CAP=250

# ImageKit Storage (Resume and Logo uploads)
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id

# Redis (Optional: if omitted, in-memory rate limiting is used)
# REDIS_URL=redis://127.0.0.1:6379

# Seed Admin Account (used by npm run seed:admin)
ADMIN_EMAIL=admin@careeros.com
ADMIN_PASSWORD=YourStrongAdminPassword123!
ADMIN_NAME=System Admin
